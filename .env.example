# Copy to .env and fill only what you use. Never commit .env.
PYTHON_ENGINE_URL=http://localhost:8000
# Engine security: set a strong key in production. The orchestrator sends it
# as X-API-Key. Leave empty only for local development.
ENGINE_API_KEY=
ENGINE_RATE_LIMIT_PER_MINUTE=120
ENGINE_MAX_BODY_BYTES=1048576
ENGINE_TIMEOUT_MS=15000
LLM_PROVIDER=mock
# gemini | openai | anthropic | ollama | mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
DATABASE_URL=
# postgres for pgvector in production, Chroma is local dev default
